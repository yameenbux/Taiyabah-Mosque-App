{"n":107,"name":"الماعون","nameEn":"Al-Ma'un","meaning":"Small Kindnesses","revealed":"Makkah","ayahs":7,"translation":"Abdullah Yusuf Ali","verses":[{"n":1,"ar":"اَرَءَيۡتَ الَّذِيۡ يُكَذِّبُ بِالدِّيۡنِؕ‏","en":"Seest thou one who denies the Judgment (to come)"},{"n":2,"ar":"فَذٰلِكَ الَّذِيۡ يَدُعُّ الۡيَتِيۡمَۙ‏","en":"Then such is the (man) who repulses the orphan (with harshness)"},{"n":3,"ar":"وَلَا يَحُضُّ عَلٰي طَعَامِ الۡمِسۡكِيۡنِؕ‏","en":"And encourages not the feeding of the indigent"},{"n":4,"ar":"فَوَيۡلٌ لِّلۡمُصَلِّيۡنَۙ‏","en":"So woe to the worshippers"},{"n":5,"ar":"الَّذِيۡنَ هُمۡ عَنۡ صَلَاتِهِمۡ سَاهُوۡنَۙ‏","en":"Who are neglectful of their prayers"},{"n":6,"ar":"الَّذِيۡنَ هُمۡ يُرَآءُوۡنَۙ‏","en":"Those who (want but) to be seen (of men)"},{"n":7,"ar":"وَيَمۡنَعُوۡنَ الۡمَاعُوۡنَࣖ‏","en":"But refuse (to supply) (even) neighbourly needs"}]}