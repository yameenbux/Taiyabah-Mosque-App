{"n":112,"name":"الإخلاص","nameEn":"Al-Ikhlas","meaning":"Sincerity","revealed":"Makkah","ayahs":4,"translation":"Abdullah Yusuf Ali","verses":[{"n":1,"ar":"قُلۡ هُوَ اللّٰهُ اَحَدٌۚ‏","en":"Say: He is Allah, the One and Only"},{"n":2,"ar":"اَللّٰهُ الصَّمَدُۚ‏","en":"Allah, the Eternal, Absolute"},{"n":3,"ar":"لَمۡ يَلِدۡ ࣢ۙ وَلَمۡ يُوۡلَدۡۙ‏","en":"He begetteth not, nor is He begotten"},{"n":4,"ar":"وَلَمۡ يَكُنۡ لَّهٗ كُفُوًا اَحَدٌࣖ‏","en":"And there is none like unto Him"}]}