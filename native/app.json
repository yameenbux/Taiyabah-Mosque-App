{
  "expo": {
    "name": "Taiyabah Masjid",
    "slug": "taiyabah-masjid",
    "scheme": "taiyabah",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#3C0B2A",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3C0B2A"
    },
    "android": {
      "package": "com.taiyabahmasjid.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#3C0B2A"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.taiyabahmasjid.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Taiyabah Masjid uses your location only to work out the Qibla direction from where you are. It is never stored and never sent anywhere.",
        "NSMotionUsageDescription": "The Qibla compass uses the motion sensors to point towards Makkah.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "1",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.taiyabahmasjid.app"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HankenGrotesk.ttf",
            "./assets/fonts/HankenGroteskMedium.ttf",
            "./assets/fonts/HankenGroteskSemiBold.ttf",
            "./assets/fonts/HankenGroteskBold.ttf",
            "./assets/fonts/Fraunces.ttf",
            "./assets/fonts/Amiri.ttf",
            "./assets/fonts/ionicons.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Taiyabah Masjid uses your location only to work out the Qibla direction from where you are. It is never stored or sent anywhere."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3C0B2A"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "smallIcons": [
            "./assets/notification-icon.png"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
