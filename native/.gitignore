node_modules/
/node_modules
dist/
.expo/

# android/ is generated by `expo prebuild` at build time. A stale copy in the
# repository is a whole class of works-on-my-machine.
android/
ios/

# The repository root ignores package.json and package-lock.json outright —
# written when the web app had no npm dependencies at all and nothing here
# was ever meant to be installed. This app IS installed, and a build with no
# manifest and no lockfile is not a build. Deeper rules win, so these two
# come back.
!package.json
!package-lock.json
.darkshots/
ios-shots/
