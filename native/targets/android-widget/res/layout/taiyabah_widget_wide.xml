<?xml version="1.0" encoding="utf-8"?>
<!-- THE RULES ARE ImageViews AND THE GAPS ARE FrameLayouts, which looks
     like somebody reaching for the wrong tag and is not. RemoteViews can
     inflate only a fixed list of classes — FrameLayout, LinearLayout,
     RelativeLayout, GridLayout, TextView, ImageView, Button, ImageButton,
     ProgressBar, Chronometer, AnalogClock, TextClock and the adapter views —
     and "descendants of these classes are not supported". A bare <View> is
     not on that list, and <Space> is a descendant of View, so neither can be
     inflated. scripts/check-android-widget.mjs holds the real list. -->
<!-- WIDE — a header that answers "which prayer, and how long" and a strip of
     all six times underneath: begins on top, jamāʿah below, the next jamāʿah
     boxed in gold. Sunrise (Shurūq) carries a dash where a congregation time
     would be, because there is no congregation at sunrise. Written as six
     columns in full rather than a loop, because RemoteViews has none: the
     provider fills tw_cN_* by index. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/taiyabah_widget_bg">

  <ImageView
      android:layout_width="220dp"
      android:layout_height="220dp"
      android:layout_gravity="bottom|end"
      android:layout_marginEnd="-86dp"
      android:layout_marginBottom="-92dp"
      android:alpha="0.04"
      android:scaleType="fitCenter"
      android:src="@drawable/taiyabah_girih"
      android:contentDescription="@null" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="11dp"
      android:paddingBottom="10dp">

    <!-- Header: the Taiyabah wordmark centred, with the next jamāʿah and its
         countdown centred beneath it. -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="center_horizontal"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/taiyabah_wordmark"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="true">
      <TextView
          android:id="@+id/tw_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#FDF7EC"
          android:textSize="17sp"
          android:fontFamily="serif"
          android:maxLines="1"
          android:ellipsize="end" />
      <Chronometer
          android:id="@+id/tw_until"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="11dp"
          android:textColor="#F0CF78"
          android:textSize="17sp"
          android:textStyle="bold"
          android:maxLines="1"
          android:includeFontPadding="false" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/taiyabah_rule"
        android:contentDescription="@null" />

    <!-- Strip of six: Fajr · Sunrise · Zuhr · Asr · Maghrib · Isha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"
          android:id="@+id/tw_c0_box" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/tw_c0_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C9B2C2" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/tw_c0_begin" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#F6F1E6" android:textSize="13sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/tw_c0_jam" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp"
            android:paddingBottom="1dp" android:textColor="#DCBB63" android:textSize="10sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
      </LinearLayout>

      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"
          android:id="@+id/tw_c1_box" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/tw_c1_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C9B2C2" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/tw_c1_begin" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#F6F1E6" android:textSize="13sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/tw_c1_jam" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp"
            android:paddingBottom="1dp" android:textColor="#DCBB63" android:textSize="10sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
      </LinearLayout>

      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"
          android:id="@+id/tw_c2_box" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/tw_c2_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C9B2C2" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/tw_c2_begin" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#F6F1E6" android:textSize="13sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/tw_c2_jam" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp"
            android:paddingBottom="1dp" android:textColor="#DCBB63" android:textSize="10sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
      </LinearLayout>

      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"
          android:id="@+id/tw_c3_box" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/tw_c3_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C9B2C2" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/tw_c3_begin" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#F6F1E6" android:textSize="13sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/tw_c3_jam" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp"
            android:paddingBottom="1dp" android:textColor="#DCBB63" android:textSize="10sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
      </LinearLayout>

      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"
          android:id="@+id/tw_c4_box" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/tw_c4_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C9B2C2" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/tw_c4_begin" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#F6F1E6" android:textSize="13sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/tw_c4_jam" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp"
            android:paddingBottom="1dp" android:textColor="#DCBB63" android:textSize="10sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
      </LinearLayout>

      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"
          android:id="@+id/tw_c5_box" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/tw_c5_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C9B2C2" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/tw_c5_begin" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#F6F1E6" android:textSize="13sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/tw_c5_jam" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp"
            android:paddingBottom="1dp" android:textColor="#DCBB63" android:textSize="10sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
      </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tw_hijri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#99C6A24C"
        android:textSize="8sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>
</FrameLayout>
