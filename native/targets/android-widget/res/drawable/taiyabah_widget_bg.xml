<?xml version="1.0" encoding="utf-8"?>
<!-- The ground. A flat plum with a light source at the top left, rather than
     a band between two colours applied to a rectangle. RemoteViews cannot
     stack gradients the way SwiftUI does, so the highlight is a second layer
     with a radial gradient fading to transparent — the same intent, within
     what a drawable can express. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="22dp" />
      <solid android:color="#3C0B2A" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="22dp" />
      <gradient
          android:type="radial"
          android:centerX="0.12"
          android:centerY="0.0"
          android:gradientRadius="260dp"
          android:startColor="#8C5E1844"
          android:endColor="#003C0B2A" />
    </shape>
  </item>
</layer-list>
