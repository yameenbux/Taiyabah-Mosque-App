<?xml version="1.0" encoding="utf-8"?>
<!-- The divider between the two columns of the wide widget, fading at both
     ends so it reads as a seam and not a border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
      android:angle="270"
      android:startColor="#00C6A24C"
      android:centerColor="#61C6A24C"
      android:endColor="#00C6A24C" />
</shape>
