<?xml version="1.0" encoding="utf-8"?>
<!-- A rule that is lit rather than drawn: it fades out instead of stopping
     dead at the end. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient android:angle="0" android:startColor="#8CC6A24C" android:endColor="#0AC6A24C" />
</shape>
