{
  "name": "taiyabah-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "content": "node scripts/extract-content.mjs && node scripts/build-i18n.mjs && node scripts/import-content.mjs && node scripts/build-data.mjs",
    "test": "node --import ./scripts/test-register.mjs --test \"scripts/test/*.test.mjs\"",
    "check": "node scripts/parse-check.mjs && node scripts/check-theme.mjs && node scripts/check-refs.mjs && node scripts/check-screens.mjs --strict && node scripts/check-links.mjs && node scripts/check-boxes.mjs --strict && node scripts/check-i18n.mjs --strict && node scripts/check-extract.mjs --strict && node scripts/check-english.mjs --strict && node scripts/check-a11y.mjs --strict"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/elements": "^2.9.44",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@supabase/supabase-js": "^2.117.2",
    "esbuild": "^0.28.2",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.0",
    "expo-av": "~15.0.2",
    "expo-build-properties": "^0.13.3",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.0",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-image": "~2.0.7",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-screen-orientation": "~8.0.4",
    "expo-sensors": "~14.0.2",
    "expo-splash-screen": "^0.29.24",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.0",
    "onesignal-expo-plugin": "^2.5.0",
    "query-string": "^9.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-onesignal": "^5.4.3",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "^0.19.13"
  }
}
