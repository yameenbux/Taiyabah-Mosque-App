node_modules/
/node_modules
/package-lock.json
/package.json

# MCP server config — written by `claude mcp add -s project` and by the
# 21st.dev CLI, and can carry an API key in a plaintext header
.mcp.json

# credentials. An app pulling prayer times or a calendar needs a key,
# so this matters here more than most.
.env
.env.*
*.pem
*.key
secrets.json

# local Claude Code state, specific to one machine
.claude/settings.local.json

# tool logs, written into whatever directory the CLI is run from
vibe-session.log

# OS noise
.DS_Store
Thumbs.db

# The Android signing key never belongs in this repository.
android.keystore
*.keystore
*.keystore.b64
*.aab
*.apk

# Screenshots from scripts/shots.mjs — a working artefact, not a deliverable.
.shots/

# Output of the emulator smoke run.
smoke-out/

# Scratch output of scripts/compare-all.mjs — the two halves of each
# comparison, rewritten on every run. The joined side-by-sides that are
# actually worth keeping are committed under native/final/.
.compare/

# Google Play service account keys. EAS submits to Play with one of these, and
# the sane place to keep it is on EAS's servers (eas credentials, or the Expo
# dashboard) where the repository never sees it at all. But the file arrives as
# a download with whatever name Google Cloud gave it, often straight into the
# project folder, and it is a working credential for the masjid's Play listing:
# anyone holding it can push a release. These patterns are the backstop for the
# afternoon somebody runs `git add .` without looking.
*service-account*.json
*serviceaccount*.json
google-play-*.json
play-store-*.json
